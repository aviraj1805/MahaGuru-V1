# Copy to apps/api/.env for local development. Never commit the real .env.
ENV=development
WEB_ORIGIN=http://localhost:5173

# SQLite works out of the box; for Postgres use docker compose (see README):
# DATABASE_URL=postgresql://mahaguru:mahaguru@localhost:5432/mahaguru
DATABASE_URL=sqlite+aiosqlite:///./mahaguru.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

# --- AI provider -------------------------------------------------------------
# gemini (free key: https://aistudio.google.com/apikey) | openai_compat | fake (offline demo)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_FAST_MODEL=gemini-2.5-flash-lite

# OpenAI-compatible alternative (Groq free tier, OpenRouter, or local Ollama):
# LLM_PROVIDER=openai_compat
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_FAST_MODEL=llama-3.1-8b-instant
